# Copy this file to .env and set your Neon DB credentials.
# Example Neon JDBC URI:
# DB_URL=jdbc:postgresql://<your-neon-host>:5432/<database>?sslmode=require
# DB_USER=<your-neon-username>
# DB_PASS=<your-neon-password>

DB_URL=jdbc:postgresql://<your-neon-host>:5432/<your-database>?sslmode=require
DB_USER=<your-neon-username>
DB_PASS=<your-neon-password>
